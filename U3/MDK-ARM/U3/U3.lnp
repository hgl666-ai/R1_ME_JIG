--cpu Cortex-M3
"u3\startup_stm32f103xe.o"
"u3\main.o"
"u3\gpio.o"
"u3\adc.o"
"u3\usart.o"
"u3\stm32f1xx_it.o"
"u3\stm32f1xx_hal_msp.o"
"u3\stm32f1xx_hal_gpio_ex.o"
"u3\stm32f1xx_hal_adc.o"
"u3\stm32f1xx_hal_adc_ex.o"
"u3\stm32f1xx_hal.o"
"u3\stm32f1xx_hal_rcc.o"
"u3\stm32f1xx_hal_rcc_ex.o"
"u3\stm32f1xx_hal_gpio.o"
"u3\stm32f1xx_hal_dma.o"
"u3\stm32f1xx_hal_cortex.o"
"u3\stm32f1xx_hal_pwr.o"
"u3\stm32f1xx_hal_flash.o"
"u3\stm32f1xx_hal_flash_ex.o"
"u3\stm32f1xx_hal_exti.o"
